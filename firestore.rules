rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Multi-tenant org-tree helpers ---
    // Materialized ancestor path (root→self) of the signed-in user's org.
    function myOrgPath() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgPath;
    }
    function myOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasOrg() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             myOrgId() != null;
    }
    // An org is visible if it is an ancestor of me (on my path) or in my subtree
    // (my org id appears on its path).
    function orgVisible(orgId, orgPath) {
      return hasOrg() && (orgId in myOrgPath() || myOrgId() in orgPath);
    }
    // Partner admins: supplier/reseller admins (and platform admins) — the roles
    // allowed to read shared quota/pool state within their own subtree.
    function isPartnerAdmin() {
      return hasOrg() && (myRole() == "supplier_admin" ||
                          myRole() == "reseller_admin" ||
                          myRole() == "platform_admin");
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Scans collection
    match /scans/{scanId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Pentests collection (AI-powered pentests)
    match /pentests/{pentestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Only backend (admin SDK) updates pentests
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Targets collection
    match /targets/{targetId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Activity Logs collection
    match /activityLogs/{logId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Activity logs are immutable
    }

    // Manual Tests collection
    match /manualTests/{testId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Findings collection
    match /findings/{findingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Engagements collection
    match /engagements/{engagementId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // AI Pentest Runs collection
    match /aiPentestRuns/{runId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Pentest Requests collection
    match /pentestRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Only admins can update request status
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Multi-tenant platform (consolidated-buying) collections.
    // All mutations go through the Admin SDK (server-side, entitlement-checked);
    // clients get scoped read-only access based on their org path.
    // ---------------------------------------------------------------------

    // Org tree — read any node on my path or in my subtree. Writes: server only.
    match /orgs/{orgId} {
      allow read: if isAdmin() || orgVisible(resource.data.id, resource.data.path);
      allow write: if false;
    }

    // Tier templates — readable by any authed user; server-managed.
    match /tiers/{tierId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Quota pools — money-critical. Supplier/reseller/platform admins may read
    // pools on their path; nobody writes from the client (Admin SDK txns only).
    match /quotaPools/{orgId} {
      // Visible if the pool belongs to me or an ancestor I draw from
      // (its orgId is on my path). Subtree/child pools resolve server-side.
      allow read: if isAdmin() ||
                     (isPartnerAdmin() && resource.data.orgId in myOrgPath());
      allow write: if false;
    }

    // Per-node caps — same visibility as pools.
    match /orgCaps/{orgId} {
      allow read: if isAdmin() || isPartnerAdmin();
      allow write: if false;
    }

    // API keys — contain a secret hash. Never client-readable or writable.
    match /apiKeys/{keyId} {
      allow read, write: if false;
    }

    // Usage ledger — append-only, server-written. Readable within my subtree.
    match /usageLedger/{entryId} {
      allow read: if isAdmin() || (hasOrg() && myOrgId() in resource.data.path);
      allow write: if false;
    }

    // Provisioning jobs — readable within my subtree; server-written.
    match /provisioningJobs/{jobId} {
      allow read: if isAdmin() || (hasOrg() && myOrgId() in resource.data.path);
      allow write: if false;
    }
  }
}

